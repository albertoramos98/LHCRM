# ====================================================================
# LHCRM - Environment Configuration Example (Placeholders Only)
# ====================================================================
# Copy this file to .env and fill in real production values.
# NEVER commit real credentials to Git!

PROJECT_NAME="LHCRM - Dashboard Executivo"
ENVIRONMENT="development" # development | staging | production

# JWT Secret Key - Generate with: openssl rand -hex 32
SECRET_KEY="your_generated_random_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL for production; SQLite for local testing)
# Example PostgreSQL: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?ssl=require
# Example SQLite: sqlite+aiosqlite:///./lhcrm.db
DATABASE_URL="sqlite+aiosqlite:///./lhcrm.db"

# Supabase (Optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Frontend & CORS Origins
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# Kommo CRM Integration Defaults (Optional fallback per tenant)
KOMMO_SUBDOMAIN="demo"
KOMMO_CLIENT_ID=
KOMMO_CLIENT_SECRET=
KOMMO_REDIRECT_URI="http://localhost:8000/api/integrations/kommo/callback"
KOMMO_LONG_LIVED_TOKEN=

# System Settings
CACHE_TTL_SECONDS=60
AUTO_SYNC_INTERVAL_MINUTES=5

# Rate Limits
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SYNC_PER_MINUTE=5
